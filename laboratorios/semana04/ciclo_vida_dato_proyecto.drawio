<mxfile host="app.diagrams.net"><diagram name="Ciclo de vida del dato"><mxGraphModel dx="1500" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="&lt;b&gt;1. Captura&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Qué ocurre:&lt;/b&gt; El cliente entrega datos mínimos del proyecto.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Líder del proyecto&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Aviso de privacidad, consentimiento y minimización." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="300" height="210" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. Almacenamiento&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Qué ocurre:&lt;/b&gt; Los datos se guardan en el repositorio digital.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Administrador del sistema&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Cifrado, acceso por rol y autenticación multifactor." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="300" height="210" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. Uso&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Qué ocurre:&lt;/b&gt; La IA procesa datos para estimar cantidades y costos.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Analista de proyecto&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Finalidad limitada, registro de accesos y revisión humana." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="300" height="210" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. Compartición&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Qué ocurre:&lt;/b&gt; Se envían datos mínimos al proveedor externo.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Responsable de datos&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Anonimización, evaluación del proveedor y contrato." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="300" height="210" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. Retención&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Qué ocurre:&lt;/b&gt; Se conservan solo durante el plazo definido.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Responsable de datos&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Plazo de retención y revisión periódica." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1400" y="180" width="300" height="210" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6. Eliminación&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Qué ocurre:&lt;/b&gt; Se borran al terminar finalidad y plazo.&lt;br&gt;&lt;b&gt;Responsable:&lt;/b&gt; Administrador del sistema&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; Borrado seguro y confirmación documentada." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1740" y="180" width="300" height="210" as="geometry"/></mxCell><mxCell id="e1" value="D3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d32f2f;fontColor=#d32f2f;strokeWidth=3;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="D3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d32f2f;fontColor=#d32f2f;strokeWidth=3;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="D3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d32f2f;fontColor=#d32f2f;strokeWidth=3;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="D3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d32f2f;fontColor=#d32f2f;strokeWidth=3;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="D3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d32f2f;fontColor=#d32f2f;strokeWidth=3;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="third" value="&lt;b&gt;Tercero:&lt;/b&gt; proveedor de nube / modelo de IA&lt;br&gt;D3 solo anonimizado o generalizado cuando sea posible." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;align=left;verticalAlign=top;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1060" y="500" width="300" height="110" as="geometry"/></mxCell><mxCell id="ethird" value="D3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#d32f2f;fontColor=#d32f2f;strokeWidth=3;" edge="1" parent="1" source="s4" target="third"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>